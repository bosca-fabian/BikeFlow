# Local config
.env

# Data lives outside git: data/raw (downloads, recordings), data/lake (Delta tables), data/reports.
data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Spark leftovers when run outside the lake
spark-warehouse/
metastore_db/
derby.log
checkpoint/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Run logs (the streaming job can write here with --log-file logs/stream.log).
# The folder is kept, its contents are not.
logs/*
!logs/.gitkeep
!logs/README.md
*.log

# Documents that are not code: the course proposal, exported reports.
*.pdf

